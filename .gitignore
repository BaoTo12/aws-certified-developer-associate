# ==============================================================================
# Multi-Language & AWS Development .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains / IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.metadata/
bin/
tmp/

# NetBeans
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/

# Vim / Emacs / Sublime
*~
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# JavaScript / TypeScript / Node.js
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Packaging / Testing
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Java / JVM (Maven, Gradle)
# ------------------------------------------------------------------------------
# Maven
target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Compiled class files
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------------------------
# Go
# ------------------------------------------------------------------------------
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/

# Go workspace
go.work
go.work.sum

# ------------------------------------------------------------------------------
# .NET / C#
# ------------------------------------------------------------------------------
bin/
obj/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------------------------
# AWS & Cloud Tools
# ------------------------------------------------------------------------------
# AWS SAM
.aws-sam/

# AWS CDK
cdk.out/
.cdk.staging/

# Serverless Framework
.serverless/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# LocalStack & Docker mounts
.localstack/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
credentials
aws-credentials*

# ------------------------------------------------------------------------------
# Logs & Databases
# ------------------------------------------------------------------------------
*.log
*.sqlite
*.sqlite3
*.db
aws-sam/

# Log files
*.log
