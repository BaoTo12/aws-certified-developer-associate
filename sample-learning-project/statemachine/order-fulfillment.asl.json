{
  "Comment": "CloudTrack Order Fulfillment Standard Workflow",
  "StartAt": "CheckInventory",
  "States": {
    "CheckInventory": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:CheckInventory",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ReserveStock"
    },
    "ReserveStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:ReserveStock",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "ChoiceAllReserved"
    },
    "ChoiceAllReserved": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.allReserved",
          "BooleanEquals": true,
          "Next": "PublishOutcome"
        }
      ],
      "Default": "RollbackReservations"
    },
    "RollbackReservations": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:RollbackReservations",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "PublishOutcome"
    },
    "PublishOutcome": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:PublishOutcome",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "UpdateOrderStatus"
    },
    "UpdateOrderStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:UpdateOrderStatus",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}
